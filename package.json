{
  "name": "setimmutable",
  "title": "SetImmutable",
  "version": "0.2.0-rc.1",
  "description": "An alternative to lodash.set when your object necessary working with immutable objects.",
  "main": "setImmutable.js",
  "type": "commonjs",
  "files": [
    "setImmutable.js",
    "map.js",
    "clone.js"
  ],
  "exports": {
    ".": "./setImmutable.js",
    "./map": "./map.js",
    "./clone": "./clone.js"
  },
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "bun build src/setImmutable.ts --outfile setImmutable.js --target node --format cjs --no-bundle && bun build src/map.ts --outfile map.js --target node --format cjs --no-bundle && bun build src/clone.ts --outfile clone.js --target node --format cjs --no-bundle",
    "test": "bun node_modules/.bin/mocha",
    "test:types": "tsc --noEmit"
  },
  "keywords": [
    "setimmutable",
    "lodash-modularized"
  ],
  "author": "Jonathan Delgado <hi@jon.soy>",
  "license": "MIT",
  "dependencies": {
    "decompose.js": "^1.0.5",
    "lodash.setwith": "^4.3.2"
  },
  "devDependencies": {
    "debug": "^2.6.0",
    "deepfreeze": "^2.0.0",
    "expect-type": "^1.4.0",
    "expect.js": "^0.3.1",
    "lodash.set": "^4.3.2",
    "mocha": "^10.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonDotsoy/setImmutable.js.git"
  },
  "bugs": {
    "url": "https://github.com/JonDotsoy/setImmutable.js/issues"
  },
  "homepage": "https://github.com/JonDotsoy/setImmutable.js#readme"
}
